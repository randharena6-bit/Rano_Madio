# --- Serveur ---
APP_NAME=ranomadio-ia
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Modeles IA ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_DEVICE=auto
EMBEDDING_LAZY_LOAD=true
WHISPER_MODEL=base
WHISPER_LANGUAGE=fr

# --- Seuils metier (dedup / matching) ---
DEDUP_MAX_DISTANCE_M=200
DEDUP_MAX_AGE_HOURS=6
DEDUP_MIN_SIMILARITY=0.82
MATCH_MIN_SEMANTIC_SCORE=0.45
MATCH_MAX_DISTANCE_M=5000
MATCH_TOP_K=5

# --- Base de donnees (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ranomadio
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cache embeddings ---
EMBEDDING_CACHE_TTL_SECONDS=3600